{
  "name": "wordloop-redbook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data:extract": "node scripts/extract-redbook.mjs",
    "data:audit": "node scripts/audit-redbook.mjs",
    "data:manifest": "node scripts/build-data-manifest.mjs",
    "data:report": "node scripts/build-data-report.mjs",
    "dictionary:build": "node scripts/build-ecdict-shards.mjs",
    "dictionary:ranges": "node scripts/build-dictionary-range-index.mjs",
    "phonetic:build": "node scripts/build-phonetic-index.mjs",
    "audio:index": "node scripts/build-audio-index.mjs",
    "audio:runtime": "node scripts/build-audio-runtime-index.mjs",
    "audio:validate": "python scripts/validate-audio-index.py",
    "audio:apply-validation": "node scripts/apply-audio-remap.mjs",
    "build:info": "node scripts/build-app-info.mjs",
    "predev": "node scripts/build-app-info.mjs",
    "dev": "vinext dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "node scripts/build-app-info.mjs && node scripts/build-dictionary-range-index.mjs && node scripts/build-data-manifest.mjs --check",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/study.test.ts tests/insights.test.ts tests/data-integrity.test.ts tests/session-summary.test.ts tests/study-session.test.ts tests/performance-diagnostics.test.ts tests/performance-baseline-analysis.test.mjs tests/api-guard.test.ts",
    "test:e2e": "playwright test --config playwright.config.mjs",
    "perf:baseline": "node scripts/performance-baseline.mjs",
    "perf:reanalyze": "node scripts/performance-baseline.mjs --reanalyze",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
