# 数据资产字节级固定：跨平台不转换换行符，保证内容哈希与 data-manifest 一致
public/data/**/*.json -text
public/data/**/*.txt -text
public/data/**/*.md -text
public/data/**/*.csv -text
public/data/**/*.tsv -text

# 数据构建产物（被哈希校验）
reports/**/*.json -text
scripts/data-provenance.json -text

# 生成的数据版本模块：固定 LF
lib/data-versions.generated.ts text eol=lf

# 二进制文件
*.tsbuildinfo binary

# 源码固定 LF：保持 WSL/Windows 工作区状态一致，防止 CRLF 噪音进入 diff
# （不写 *.json / *.md 等通用规则，避免覆盖上方数据资产 -text 规则）
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.ps1 text eol=lf
